            <column name="restype" valueNumeric="0"/>
            <column name="content" valueBlobFile="../com/openbravo/pos/templates/Login.Header.txt"/>
        </insert>
    </changeSet>
    <changeSet id="20261101-login-vendor" author="kriolos">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM resources WHERE name = 'Login.Vendor'</sqlCheck>
        </preConditions>
        <insert tableName="resources">
            <column name="id" value="login-branding-vendor"/>
